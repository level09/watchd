{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "watchd",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-22",
  "compatibility_flags": ["nodejs_compat"],
  // Explicit so a deploy always serves the dashboard at the workers.dev URL; preview URLs off so old versions are not reachable.
  "workers_dev": true,
  "preview_urls": false,
  // One tick per minute; agents carry their own cron schedules (UTC).
  "triggers": { "crons": ["* * * * *"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "watchd",
      "database_id": "fa7b897b-0a22-4267-84b6-763fc4e8522f",
      "migrations_dir": "migrations",
    },
  ],
  "send_email": [{ "name": "EMAIL" }],
  // Browser Run for the browse and links tools; quick actions only work remotely, even in wrangler dev.
  "browser": { "binding": "BROWSER", "remote": true },
  "vars": {
    // Dated snapshot: $0.036 in, $0.50 out per 1M tokens against $0.30 and $1.20 for the undated slug
    // (openrouter.ai/api/v1/models, checked 2026-11-20). One local run of a daily digest agent each: $0.0024 against $0.0042, reports on par.
    // Go back to deepseek/deepseek-v4.1-flash if the snapshot is retired, repriced or its reports slip.
    "DEFAULT_MODEL": "deepseek/deepseek-v4.1-flash-1017",
    "DAILY_CAP_USD": "1.00",
    // Optional: set NOTIFY_EMAIL and EMAIL_FROM (an Email Sending domain) to get results by email.
  },
  // Secrets: OPENROUTER_API_KEY and RUN_TOKEN, set with `wrangler secret put` (.dev.vars locally).
  // The every-minute tick would write 1,440 invocation logs a day; keep only what the code logs (skips and failures).
  "observability": { "enabled": true, "logs": { "invocation_logs": false } },
}
